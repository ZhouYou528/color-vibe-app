# Google OAuth Client ID
# Get this from: https://console.cloud.google.com/apis/credentials
# Create a new OAuth 2.0 Client ID for a Web application
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Google OAuth Client Secret (for next-auth)
# Get this from the same place as the Client ID
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=color-vibe-previews

# GCP Service Account (choose one method):
# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: Inline JSON (for Vercel/deployment)
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Gemini AI Configuration
# Get API key from: https://aistudio.google.com/
# Free tier: 5 requests/minute, 25 requests/day (no credit card required)
GEMINI_API_KEY=your-gemini-api-key-here
